{
  "name": "zjuam-auth",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-dependency Node.js client for ZJUam CAS login, service-ticket callbacks, and OAuth2 authorization-code callbacks.",
  "type": "commonjs",
  "main": "./src/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs",
      "require": "./src/index.cjs"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.cjs\"",
    "typecheck": "tsc --noEmit --strict --module nodenext --moduleResolution nodenext test/types-check.mts"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "zju",
    "zjuam",
    "cas",
    "oauth2",
    "authentication",
    "sso",
    "nodejs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cillo-x/zjuam-auth.git"
  },
  "homepage": "https://github.com/Cillo-x/zjuam-auth#readme",
  "bugs": "https://github.com/Cillo-x/zjuam-auth/issues",
  "license": "GPL-3.0-or-later"
}
